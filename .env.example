# 이 파일을 .env.local 로 복사해서 쓴다 (.env.local 은 git 에 올라가지 않는다).
# 지금은 로그인이 꺼져 있어(src/lib/features.ts) 아무 값도 넣지 않아도 앱이 그대로 돈다.
#
# VITE_ 로 시작하는 값은 번들에 그대로 들어간다. 공개돼도 되는 값만 넣는다.
# 클라이언트 시크릿 · 보안 비밀번호는 여기에 넣지 않는다 (백엔드에만 준다).

# 카카오디벨로퍼스 > [앱] > [플랫폼 키] > [REST API 키]
VITE_KAKAO_REST_API_KEY=

# Google Auth Platform > [클라이언트] > 클라이언트 ID (.apps.googleusercontent.com 으로 끝남)
VITE_GOOGLE_CLIENT_ID=

# /api 를 넘길 백엔드. 비워 두면 배포된 백엔드(https://ssokssok-backend.fly.dev)를 쓴다.
# 로컬 백엔드를 띄웠을 때만 주석을 푼다.
# API_PROXY_TARGET=http://localhost:8000
